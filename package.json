{
  "name": "listen1_chrome_extension",
  "version": "2.33.0",
  "description": "one for all free music in china",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "wasm:build": "cargo build --manifest-path rust-fuzzy/Cargo.toml --target wasm32-unknown-unknown --release && wasm-bindgen rust-fuzzy/target/wasm32-unknown-unknown/release/fuzzy_search.wasm --out-dir rust-fuzzy/pkg --target web",
    "desktop:start": "electron .",
    "desktop:build": "electron-builder --win --x64",
    "desktop:build:portable": "electron-builder --win --x64 --portable"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen1/listen1_chrome_extension.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/listen1/listen1_chrome_extension/issues"
  },
  "build": {
    "appId": "com.listen1.desktop",
    "productName": "Listen1",
    "files": [
      "**/*",
      "!*.log",
      "node_modules/@electron/remote/**/*"
    ],
    "extraResources": [
      {
        "from": "rust-fuzzy/pkg",
        "to": "rust-fuzzy/pkg"
      }
    ],
    "asarUnpack": [
      "node_modules/@electron/remote/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    }
  },
  "homepage": "https://github.com/listen1/listen1_chrome_extension#readme",
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^7.30.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.23.4",
    "husky": "^4.3.8",
    "lint-staged": "^10.5.4",
    "prettier": "^2.3.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "!(**/vendor/*.js)*.js": "eslint --cache --fix",
    "!(**/vendor/*.js)*.{js,css,md}": "prettier --write"
  }
}